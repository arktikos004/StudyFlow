{
	"name": "studyflow",
	"description": "StudyFlow 學生學習管理系統：考試、任務、學習計時、錯題複習與學習統計",
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@hono/zod-validator": "^0.9.1",
		"@tanstack/react-query": "^5.104.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.10",
		"lucide-react": "^1.48.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"react-router": "^8.4.0",
		"recharts": "^3.10.1",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.62.0",
		"@cloudflare/vitest-plugin": "^1.3.1",
		"@eslint/js": "9.39.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vite-pwa/assets-generator": "^1.0.4",
		"@vitejs/plugin-react": "^6.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^8.3.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "~4.1.11",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.143.0"
	},
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "npm run build && vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -b && tsc -p test/tsconfig.json --noEmit",
		"check": "npm run typecheck && vite build && wrangler deploy --dry-run",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply studyflow-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply studyflow-db --remote",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"test/**/*.ts\""
	},
	"type": "module",
	"allowScripts": {
		"esbuild@0.28.1": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"workerd@1.20260926.1": true,
		"fsevents@2.3.3": true
	}
}
