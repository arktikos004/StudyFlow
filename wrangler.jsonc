{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "studyflow",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		// API 一律交給 Worker 處理，不會被 SPA fallback 攔截成 index.html
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "studyflow-db",
			// 由 `wrangler d1 create studyflow-db --location apac` 建立
			"database_id": "eeec6525-0eec-4a1d-8a7a-d5b43d90ba51",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "studyflow-uploads"
		}
	],
	"routes": [
		{
			"pattern": "studyflow.sekinv.com",
			"custom_domain": true
		}
	]
}
